# llm-proxy 启动期环境变量（已 gitignore 实际 .env）
# 复制为 .env 后按本机环境修改；.env 不入版本库。

# ===== Database =====
# 容器内（共享 network：shared-net）使用 Docker DNS 名 postgres
# 宿主机本地直连：把 postgres 换成 127.0.0.1
# DATABASE_URL=postgres://dev:dev@postgres:5432/llmproxy_dev
# DATABASE_URL=postgres://dev:dev@127.0.0.1:5432/llmproxy_dev

# 可选：单独设置 PG 用户/密码/库，方便 docker-compose 与本地直连共享
POSTGRES_USER=dev
POSTGRES_PASSWORD=changeme
POSTGRES_DB=llmproxy_dev

# ===== Server =====
PORT=9000
PROXY_KEY=
LOG_LEVEL=info
NODE_ENV=production
